      "id": "3f4dc4bb-996e-49e9-b3d3-871900403375"
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body;\nconst products = body?.needs_restock;\n\nif (!products || !Array.isArray(products) || products.length === 0) {\n  throw new Error('Invalid payload: needs_restock array is missing or empty');\n}\n\n// Build one Telegram message covering all low stock items\nlet message = '\ud83d\udd34 *RESTOCK ALERT*\\n';\nmessage += `_${products.length} product${products.length > 1 ? 's' : ''} need${products.length === 1 ? 's' : ''} restocking_\\n\\n`;\n\nproducts.forEach((p, i) => {\n  message += `*${i + 1}. ${p.name}*\\n`;\n  message += `   \ud83d\udce6 Stock: ${p.quantity} ${p.unit} _(min: ${p.min_threshold})_\\n`;\n  message += `   \ud83d\udcb0 Price: \u20b9${p.price}/${p.unit}\\n\\n`;\n});\n\nmessage += '_Please reorder via the dashboard._';\n\nreturn [{ json: { message, count: products.length } }];"
      },
      "name": "Build Alert Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1920,
        1648
      ],
      "id": "8e3b0b22-5eb8-4cff-be32-059c1681fe96"
    },
    {
