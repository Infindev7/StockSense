# ==========================================
# StockSense Environment Configuration
# ==========================================

# Database Configuration
MONGO_URI=mongodb://localhost:27017
DB_NAME=stocksense_db

# Server Configuration
PORT=8000
HOST=0.0.0.0

# External Automation & Integrations (n8n Webhook for Telegram Alerts)
N8N_RESTOCK_WEBHOOK_URL=https://your-n8n-instance.cloud/webhook/restock-alert

# Frontend API Endpoint (Optional override for custom deployments)
VITE_API_BASE_URL=http://localhost:8000
